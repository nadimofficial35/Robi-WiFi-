    async function handleLogin(e) {
      e.preventDefault();

      const rawNumber = document.getElementById('loginNumber').value.trim();
      const normNumber = formatPhoneNumber(rawNumber);
      const password = document.getElementById('loginPassword').value.trim();
      const btn = document.getElementById('loginBtn');
      btn.innerText = 'Logging in...';
      btn.disabled = true;

      try {
        const reqUrl = `${WEB_APP_URL}?action=login&number=${encodeURIComponent(normNumber)}&password=${encodeURIComponent(password)}&t=${Date.now()}`;
        const res = await fetch(reqUrl, { method: 'GET', redirect: 'follow' });
        const data = await res.json();
        
        if (data.status === 'success' && data.user) {
          completeLoginSuccess(data.user);
          return;
        }

        const syncRes = await fetch(`${WEB_APP_URL}?action=syncAll&t=${Date.now()}`, { method: 'GET', redirect: 'follow' });
        const syncData = await syncRes.json();
        if (syncData.status === 'success' && Array.isArray(syncData.users)) {
          const matchedUser = syncData.users.find(u => formatPhoneNumber(u.number) === normNumber && String(u.password).trim() === password);
          if (matchedUser) {
            completeLoginSuccess(matchedUser);
            return;
          }
        }

        alert(data.message || 'Number অথবা Password ভুল!');
      } catch (err) {
        alert('Connection Error! ইন্টারনেট বা সার্ভার চেক করুন।');
      } finally {
        btn.innerText = 'Login';
        btn.disabled = false;
      }
    }

