  <script>
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbxEucCJhbOlfO5kKuIQVkdGruOQGkmKqKWtfkefxWoz8-j3H3MdaXMHaaKu3x8IPujD/exec";
    
    let currentUser = null;
    let cachedReports = JSON.parse(localStorage.getItem('robi_cache_reports') || '[]');
    let cachedQuizMap = JSON.parse(localStorage.getItem('robi_cache_quiz') || '{}');
    let cachedUsers = JSON.parse(localStorage.getItem('robi_cache_users') || '[]');

    let latestInvoiceData = {
      custName: '',
      custEmail: '',
      invNumber: '',
      invDate: '',
      desc1: '',
      unit1: '0',
      amt1: '0.00',
      desc2: '',
      unit2: '0',
      amt2: '0.00',
      desc3: '',
      unit3: '0',
      amt3: '0.00',
      subtotal: '0.00',
      total: '0.00'
    };

    window.onload = function() {
      generateInvoiceQRCode();
      const savedUser = localStorage.getItem('robi_user');
      if (savedUser) {
        try {
          currentUser = JSON.parse(savedUser);
          if (currentUser && currentUser.idNumber) {
            setupUserUI();
            navigateTo('homePage');
            syncAllData(false);
            return;
          }
        } catch (e) {
          localStorage.removeItem('robi_user');
        }
      }
      navigateTo('loginPage');
      syncAllData(false);
    };

    function generateInvoiceQRCode() {
      const qrBox = document.getElementById('invoiceQrBox');
      if (!qrBox) return;
      qrBox.innerHTML = '';
      if (typeof QRCode !== 'undefined') {
        try {
          new QRCode(qrBox, {
            text: "https://www.youtube.com/@robiwifibd",
            width: 102,
            height: 102,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
          });
        } catch (err) {
          qrBox.innerHTML = '<span style="font-size:10px;color:#555;">robiwifibd</span>';
        }
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toastMsg');
      toast.innerText = msg;
      toast.classList.remove('hidden-page');
      setTimeout(() => toast.classList.add('hidden-page'), 2400);
    }

    function getTodayDateKey() {
      const now = new Date();
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Dhaka',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).formatToParts(now);
      const y = parts.find(p => p.type === 'year').value;
      const m = parts.find(p => p.type === 'month').value;
      const d = parts.find(p => p.type === 'day').value;
      return `${y}-${m}-${d}`;
    }

    function getFormattedInvoiceDate() {
      const now = new Date();
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Dhaka',
        day: '2-digit',
        month: 'short',
        year: 'numeric'
      }).formatToParts(now);
      const d = parts.find(p => p.type === 'day').value;
      const m = parts.find(p => p.type === 'month').value;
      const y = parts.find(p => p.type === 'year').value;
      return `${d}-${m}-${y}`;
    }

    function openCreateInvoiceForm() {
      navigateTo('createInvoiceFormPage');
    }

    function onSl1DeviceChange() {
      const sel = document.getElementById('sl1DeviceSelect');
      const selectedOpt = sel.options[sel.selectedIndex];
      const price = selectedOpt ? (selectedOpt.getAttribute('data-price') || '') : '';
      document.getElementById('invUnit1').value = price;
    }

    function onSl2DeviceChange() {
      const sel = document.getElementById('sl2DeviceSelect');
      const selectedOpt = sel.options[sel.selectedIndex];
      const price = selectedOpt ? (selectedOpt.getAttribute('data-price') || '') : '';
      document.getElementById('invUnit2').value = price;
    }

    function formatAmountPlain(val) {
      const num = parseFloat(val) || 0;
      return num.toFixed(2);
    }

    function formatAmountComma(val) {
      const num = parseFloat(val) || 0;
      return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatUnitDisplay(val) {
      const num = parseFloat(val) || 0;
      if (num === 0) return "0";
      return num.toLocaleString('en-US');
    }

    function handleInvoiceNext(e) {
      e.preventDefault();

      const custName = document.getElementById('invCustName').value.trim();
      const custEmail = document.getElementById('invCustEmail').value.trim();
      const invNumber = document.getElementById('invNumber').value.trim();
      const invDate = getFormattedInvoiceDate();

      const sl1Device = document.getElementById('sl1DeviceSelect').value;
      const unit1Raw = parseFloat(document.getElementById('invUnit1').value) || 0;
      const desc1Input = document.getElementById('invDesc1').value.trim();
      const fullDesc1 = desc1Input ? `(${sl1Device}) - ${desc1Input}` : sl1Device;

      const sl2Device = document.getElementById('sl2DeviceSelect').value;
      const unit2Raw = parseFloat(document.getElementById('invUnit2').value) || 0;

      const desc3Input = document.getElementById('invDesc3').value.trim();
      const unit3Raw = 0;

      const amt1 = unit1Raw;
      const amt2 = unit2Raw;
      const amt3 = unit3Raw;
      const subtotal = amt1 + amt2 + amt3;
      const total = subtotal;

      const unit1Str = formatUnitDisplay(unit1Raw);
      const amt1Str = formatAmountPlain(amt1);
      const unit2Str = formatUnitDisplay(unit2Raw);
      const amt2Str = formatAmountPlain(amt2);
      const subtotalStr = formatAmountPlain(subtotal);
      const totalStr = formatAmountComma(total);

      latestInvoiceData = {
        custName,
        custEmail,
        invNumber,
        invDate,
        desc1: fullDesc1,
        unit1: unit1Str,
        amt1: amt1Str,
        desc2: sl2Device,
        unit2: unit2Str,
        amt2: amt2Str,
        desc3: desc3Input,
        unit3: "0",
        amt3: "0.00",
        subtotal: subtotalStr,
        total: totalStr
      };

      document.getElementById('outCustName').innerText = custName;
      document.getElementById('outCustEmail').innerText = custEmail;
      document.getElementById('outInvNumber').innerText = invNumber;
      document.getElementById('outInvDate').innerText = invDate;

      document.getElementById('outDesc1').innerText = fullDesc1;
      document.getElementById('outUnit1').innerText = unit1Str;
      document.getElementById('outAmt1').innerText = amt1Str;

      document.getElementById('outDesc2').innerText = sl2Device;
      document.getElementById('outUnit2').innerText = unit2Str;
      document.getElementById('outAmt2').innerText = amt2Str;

      document.getElementById('outDesc3').innerText = desc3Input;
      document.getElementById('outUnit3').innerText = "0";
      document.getElementById('outAmt3').innerText = "0.00";

      document.getElementById('outSubtotal').innerText = subtotalStr;
      document.getElementById('outTotal').innerText = totalStr;

      generateInvoiceQRCode();
      navigateTo('invoicePreviewPage');

      const scrollBox = document.getElementById('previewScrollContainer');
      if (scrollBox) scrollBox.scrollLeft = 0;
    }

    function downloadInvoicePDF() {
      const btn = document.getElementById('downloadPdfBtn');
      const originalHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Generating PDF...</span>';
        btn.disabled = true;
      }

      setTimeout(() => {
        try {
          if (!window.jspdf || !window.jspdf.jsPDF) {
            throw new Error("jsPDF not loaded");
          }

          const { jsPDF } = window.jspdf;
          const doc = new jsPDF({
            orientation: 'portrait',
            unit: 'mm',
            format: 'a4'
          });

          const d = latestInvoiceData;
          const safeInvNum = (d.invNumber || 'Invoice').replace(/[^a-zA-Z0-9_-]/g, '_');
          const fileName = `Robi_WiFi_Invoice_${safeInvNum}.pdf`;

          // Top Brand Header
          doc.setFillColor(220, 38, 38);
          doc.rect(0, 0, 210, 28, 'F');

          doc.setTextColor(255, 255, 255);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(18);
          doc.text('ROBI WIFI', 14, 13);

          doc.setFontSize(10);
          doc.setFont('helvetica', 'normal');
          doc.text('Invoice & Billing Statement', 14, 20);

          doc.setFont('helvetica', 'bold');
          doc.setFontSize(16);
          doc.text('INVOICE', 196, 14, { align: 'right' });
          doc.setFontSize(10);
          doc.text('+8801899999999', 196, 21, { align: 'right' });

          // Status badge text
          doc.setTextColor(22, 163, 74);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.text('STATUS: COMPLETED', 196, 36, { align: 'right' });

          // Billed To Section
          doc.setTextColor(17, 24, 39);
          doc.setFontSize(13);
          doc.text('Billed To', 14, 38);

          doc.setDrawColor(209, 213, 219);
          doc.line(14, 41, 196, 41);

          doc.setFontSize(10);
          doc.setFont('helvetica', 'bold');
          doc.text('Customer Name:', 14, 49);
          doc.setFont('helvetica', 'normal');
          doc.text(String(d.custName || '-'), 52, 49);

          doc.setFont('helvetica', 'bold');
          doc.text('Invoice No:', 125, 49);
          doc.setFont('helvetica', 'normal');
          doc.text(String(d.invNumber || '-'), 155, 49);

          doc.setFont('helvetica', 'bold');
          doc.text('Customer E-mail:', 14, 57);
          doc.setFont('helvetica', 'normal');
          doc.text(String(d.custEmail || '-'), 52, 57);

          doc.setFont('helvetica', 'bold');
          doc.text('Invoice Date:', 125, 57);
          doc.setFont('helvetica', 'normal');
          doc.text(String(d.invDate || getFormattedInvoiceDate()), 155, 57);

          doc.setFont('helvetica', 'bold');
          doc.text('Payment Mode: COD', 14, 66);

          // Table Header
          const tableTop = 74;
          doc.setFillColor(243, 244, 246);
          doc.rect(14, tableTop, 182, 9, 'F');
          doc.setDrawColor(55, 65, 81);
