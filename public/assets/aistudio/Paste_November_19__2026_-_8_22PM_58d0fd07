    async function syncAllData(showNotify = false) {
      const badge = document.getElementById('syncBadge');
      if (badge) badge.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Syncing...';

      try {
        const res = await fetch(`${WEB_APP_URL}?action=syncAll&t=${Date.now()}`, { method: 'GET', redirect: 'follow' });
        const data = await res.json();
        if (data.status === 'success') {
          cachedReports = data.reports || [];
          cachedQuizMap = data.quizMap || {};
          if (data.users) cachedUsers = data.users;

          localStorage.setItem('robi_cache_reports', JSON.stringify(cachedReports));
          localStorage.setItem('robi_cache_quiz', JSON.stringify(cachedQuizMap));
          localStorage.setItem('robi_cache_users', JSON.stringify(cachedUsers));

          if (badge) badge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Live';
          if (showNotify) {
            showToast('সব ডেটা আপডেট হয়েছে!');
            renderMyReportsFromCache();
            instantSearchSr();
          }
        }
      } catch (err) {
        if (badge) badge.innerHTML = '<i class="fa-solid fa-bolt"></i> Offline Cache';
      }
