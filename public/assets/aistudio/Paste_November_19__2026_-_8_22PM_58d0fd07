        supervisor: currentUser.supervisor || ''
      };
      cachedReports.unshift(newEntry);
      localStorage.setItem('robi_cache_reports', JSON.stringify(cachedReports));

      document.getElementById('srId').value = '';
      document.getElementById('statusSelect').value = '';
      document.getElementById('comment').value = '';
      document.getElementById('newDate').value = '';
      toggleNewDateField();
      navigateTo('homePage');
      showToast('Report Submitted Successfully!');

      fetch(WEB_APP_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          type: 'report',
          idNumber: currentUser.idNumber,
          srId: srId,
          status: status,
          newDate: status === 'Customer Reschudul' ? newDate : '',
          comment: comment,
          supervisor: currentUser.supervisor || ''
        })
      });
    }

    function renderMyReportsFromCache() {
      if (!currentUser) return;
      const container = document.getElementById('reportList');
      const targetId = String(currentUser.idNumber).trim().toLowerCase();
      const todayKey = getTodayDateKey();

      const dateLabel = document.getElementById('todayDateLabel');
      if (dateLabel) dateLabel.innerText = 'Date: ' + todayKey;

      const todayList = cachedReports.filter(r => {
        const matchId = String(r.idNumber || '').trim().toLowerCase() === targetId;
        if (!matchId) return false;
        if (r.dateKey) return r.dateKey === todayKey;
        if (r.dateTime) {
          const parsed = new Date(r.dateTime);
          if (!isNaN(parsed.getTime())) {
            const k = `${parsed.getFullYear()}-${String(parsed.getMonth() + 1).padStart(2, '0')}-${String(parsed.getDate()).padStart(2, '0')}`;
            return k === todayKey;
          }
        }
        return false;
      });

      if (todayList.length === 0) {
        container.innerHTML = '<p class="text-gray-400 text-center py-6">আজকের কোনো রিপোর্ট পাওয়া যায়নি।</p>';
        return;
      }

      container.innerHTML = todayList.map(r => `
        <div class="border rounded-lg p-3 bg-gray-50 space-y-1.5 shadow-sm">
          <div class="flex justify-between items-center font-bold text-gray-800">
            <span>SR ID: ${r.srId}</span>
            <span class="text-xs px-2 py-0.5 rounded ${r.status === 'Cancel' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700'}">${r.status}</span>
          </div>
          <div class="text-xs text-amber-700 font-medium"><i class="fa-solid fa-calendar-days mr-1"></i> Next Date: ${r.nextDate || 'N/A'}</div>
          <div class="text-xs text-gray-600"><strong>Comment:</strong> ${r.comment}</div>
          <div class="text-xs text-gray-500"><strong>Supervisor:</strong> ${r.supervisor}</div>
          <div class="text-[10px] text-gray-400 text-right border-t pt-1 mt-1"><i class="fa-regular fa-clock mr-1"></i> ${r.dateTime}</div>
        </div>
      `).join('');
    }

    function openProfileModal() { document.getElementById('profileModal').classList.remove('hidden-page'); }
    function closeProfileModal() { document.getElementById('profileModal').classList.add('hidden-page'); }

    function openMyReportsFromSetting() {
      navigateTo('myReportPage');
      renderMyReportsFromCache();
      syncAllData(false);
    }

    function logout() {
      localStorage.removeItem('robi_user');
      currentUser = null;
      closeProfileModal();
      document.getElementById('mainHeader').classList.add('hidden-page');
      document.getElementById('bottomNav').classList.add('hidden-page');
      navigateTo('loginPage');
    }
  </script>
</body>
</html>
