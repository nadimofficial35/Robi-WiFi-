    function formatPhoneNumber(num) {
      let cleaned = String(num || "").trim().replace(/\D/g, '');
      if (cleaned.startsWith('880') && cleaned.length === 13) {
        cleaned = '0' + cleaned.slice(3);
      } else if (cleaned.length === 10 && !cleaned.startsWith('0')) {
        cleaned = '0' + cleaned;
      }
      return cleaned;
    }

