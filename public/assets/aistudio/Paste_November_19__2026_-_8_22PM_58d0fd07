<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robi WiFi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    .hidden-page { display: none !important; }

    /* Invoice Sheet Styling (Exact A4 width 794px) */
    .invoice-sheet {
      width: 794px;
      min-height: 1050px;
      margin: 0 auto;
      background: #ffffff;
      color: #111827;
      padding: 32px 38px;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
      position: relative;
      border: 1px solid #d1d5db;
    }
    .inv-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
    }
    .inv-logo-mark {
      width: 74px;
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .inv-completed-badge {
      color: #16a34a;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: 3px;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      margin-top: 6px;
      line-height: 1;
      display: inline-block;
    }
    .inv-header-right {
      text-align: right;
      line-height: 1.25;
    }
    .inv-title {
      font-size: 34px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000000;
    }
    .inv-brand {
      font-size: 16px;
      font-weight: 800;
      color: #111827;
      margin-top: 2px;
    }
    .inv-phone {
      font-size: 15px;
      font-weight: 800;
      color: #111827;
      margin-top: 2px;
    }
    .inv-billed-title {
      font-size: 18px;
      font-weight: 800;
      color: #111827;
      margin-bottom: 10px;
    }
    .inv-meta-grid {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-size: 13px;
      margin-bottom: 8px;
    }
    .inv-meta-left, .inv-meta-right {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .inv-meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .inv-label {
      font-weight: 700;
      color: #111827;
      min-width: 122px;
    }
    .inv-line-val {
      border-bottom: 1px solid #374151;
      padding: 2px 10px;
      min-width: 160px;
      text-align: center;
      font-weight: 600;
    }
    .inv-box-val {
      border: 1.5px solid #111827;
      padding: 3px 12px;
      min-width: 155px;
      text-align: center;
      font-weight: 800;
    }
    .inv-payment-mode {
      font-size: 13px;
      font-weight: 700;
      margin: 14px 0 22px 0;
    }
    .inv-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-bottom: 26px;
    }
    .inv-table th {
      border: 1.5px solid #1f2937;
      padding: 9px 6px;
      font-weight: 800;
      text-align: center;
      background: #ffffff;
    }
    .inv-table td {
      border: 1px solid #374151;
      padding: 10px 8px;
      text-align: center;
      font-weight: 600;
    }
    .inv-bottom-grid {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 12px;
    }
    .inv-qr-box {
      width: 112px;
      height: 112px;
      border: 1px solid #d1d5db;
      padding: 5px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .inv-qr-box img, .inv-qr-box canvas {
      width: 100% !important;
      height: 100% !important;
      display: block;
    }
    .inv-totals-box {
      min-width: 250px;
      font-size: 13px;
    }
    .inv-total-line {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      font-weight: 700;
    }
    .inv-grand-total {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      margin-top: 4px;
      border-top: 1px solid #9ca3af;
      font-size: 15px;
      font-weight: 800;
    }
    .inv-footer-links {
      margin-top: 16px;
      font-size: 12px;
    }
    .inv-yt-link {
      color: #2563eb;
      text-decoration: underline;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 20px;
    }
    .inv-bottom-center {
      text-align: center;
      margin-top: 12px;
    }
    .inv-web-link {
      color: #2563eb;
      text-decoration: underline;
      font-size: 12px;
      font-weight: 600;
      display: block;
      margin-bottom: 8px;
    }
    .inv-thank-btn {
      display: inline-block;
      background: #16a34a;
      color: #ffffff;
      font-weight: 700;
      font-size: 13px;
      padding: 5px 28px;
      border-radius: 2px;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen font-sans pb-20">

  <!-- App Header -->
  <header id="mainHeader" class="bg-red-600 text-white shadow-md hidden-page select-none sticky top-0 z-40">
    <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
      <div onclick="navigateTo('homePage')" class="flex items-center space-x-2 cursor-pointer hover:opacity-90 transition">
        <div class="w-8 h-8 rounded-full bg-white text-red-600 flex items-center justify-center font-bold text-sm shadow">
          <i class="fa-solid fa-wifi"></i>
        </div>
        <h1 class="text-xl font-bold tracking-wide">Robi WiFi</h1>
      </div>

      <div id="headerProfile" class="flex items-center space-x-2 cursor-pointer" onclick="openProfileModal()">
        <span id="headerBdoName" class="font-medium text-sm"></span>
        <div class="w-9 h-9 rounded-full bg-white text-red-600 font-bold flex items-center justify-center border-2 border-white shadow overflow-hidden">
          <img id="headerUserImg" src="" alt="Profile" class="w-full h-full object-cover hidden">
          <i id="headerUserIcon" class="fa-solid fa-user"></i>
        </div>
      </div>
    </div>
  </header>

  <!-- Instant Toast Notification -->
  <div id="toastMsg" class="fixed top-16 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-lg hidden-page z-50 transition"></div>

  <!-- Main Container -->
  <div class="max-w-md mx-auto p-4">

    <!-- LOGIN PAGE -->
    <div id="loginPage" class="bg-white p-6 rounded-xl shadow-md border mt-8">
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-2 text-2xl font-bold">
          <i class="fa-solid fa-wifi"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-800">Robi WiFi Login</h2>
        <p id="connStatus" class="text-xs text-emerald-600 mt-1 font-medium"><i class="fa-solid fa-bolt mr-1"></i> Fast Mode Ready</p>
      </div>
      <form onsubmit="handleLogin(event)">
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-semibold mb-1">Number</label>
          <input type="text" id="loginNumber" required placeholder="018xxxxxxxx" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>
        <div class="mb-6">
          <label class="block text-gray-700 text-sm font-semibold mb-1">Password</label>
          <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>
        <button type="submit" id="loginBtn" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-lg shadow transition duration-200">
          Login
        </button>
      </form>
    </div>

    <!-- HOME PAGE -->
    <div id="homePage" class="hidden-page space-y-4 mt-2">
      <div class="bg-white p-4 rounded-xl shadow border">
        <div class="flex justify-between items-center mb-3 border-b pb-2">
          <h3 class="text-gray-800 font-bold text-lg">Main Menu</h3>
          <span id="syncBadge" class="text-[10px] text-emerald-600 font-semibold"><i class="fa-solid fa-circle-check"></i> Live</span>
        </div>
        <div class="grid grid-cols-1 gap-3">
          <a href="http://accesscon.robi.com.bd/" target="_blank" class="flex items-center p-3 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg text-red-700 font-semibold shadow-sm transition">
            <i class="fa-solid fa-globe text-xl w-8 text-center mr-2"></i>
            <span>accesscon</span>
          </a>

          <button onclick="navigateTo('complinePage')" class="flex items-center p-3 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg text-blue-700 font-semibold shadow-sm transition">
            <i class="fa-solid fa-file-pen text-xl w-8 text-center mr-2"></i>
            <span>Compline Report</span>
          </button>

          <button onclick="navigateTo('updateIsoPage')" class="flex items-center p-3 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg text-emerald-700 font-semibold shadow-sm transition">
            <i class="fa-solid fa-folder-open text-xl w-8 text-center mr-2"></i>
            <span>Update ISO File</span>
          </button>

          <button onclick="navigateTo('bindIssuePage')" class="flex items-center p-3 bg-purple-50 hover:bg-purple-100 border border-purple-200 rounded-lg text-purple-700 font-semibold shadow-sm transition">
            <i class="fa-solid fa-link text-xl w-8 text-center mr-2"></i>
            <span>Bind Issue</span>
          </button>

          <button onclick="openCreateInvoiceForm()" class="flex items-center p-3 bg-orange-50 hover:bg-orange-100 border border-orange-200 rounded-lg text-orange-700 font-semibold shadow-sm transition">
            <i class="fa-solid fa-file-invoice-dollar text-xl w-8 text-center mr-2"></i>
            <span>Create Invoice</span>
          </button>
        </div>
      </div>
    </div>

    <!-- CREATE INVOICE FORM PAGE -->
    <div id="createInvoiceFormPage" class="hidden-page bg-white p-5 rounded-xl shadow border">
      <div class="flex items-center mb-4 border-b pb-2">
        <button onclick="navigateTo('homePage')" class="text-gray-600 mr-3 text-lg"><i class="fa-solid fa-arrow-left"></i></button>
        <h3 class="font-bold text-lg text-gray-800">Create Invoice</h3>
      </div>

      <form onsubmit="handleInvoiceNext(event)" class="space-y-4">
        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Customer Name</label>
          <input type="text" id="invCustName" required placeholder="Enter Customer Name" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm">
        </div>

        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Customer E-mail</label>
          <input type="text" id="invCustEmail" required placeholder="Enter Customer E-mail / Contact" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm">
        </div>

        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Invoice Number</label>
          <input type="text" id="invNumber" required placeholder="Enter Invoice Number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm">
        </div>

        <!-- S.L. 01 -->
        <div class="p-3 bg-gray-50 border rounded-lg space-y-2.5">
          <div class="text-xs font-bold text-red-600 uppercase">S.L. 01</div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Device Select</label>
            <select id="sl1DeviceSelect" onchange="onSl1DeviceChange()" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm bg-white">
              <option value="">Select Device</option>
              <option value="Basic device" data-price="2499">Basic device</option>
              <option value="Plus Device" data-price="3999">Plus Device</option>
              <option value="Pro Device" data-price="9999">Pro Device</option>
            </select>
          </div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Unit Price (Auto)</label>
            <input type="number" id="invUnit1" readonly required placeholder="0" class="w-full px-3 py-2 border rounded-lg bg-gray-100 text-gray-800 font-bold text-sm outline-none">
          </div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Description</label>
            <input type="text" id="invDesc1" required placeholder="Enter Description (e.g. IMEI / Serial)" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm bg-white">
          </div>
        </div>

        <!-- S.L. 02 -->
        <div class="p-3 bg-gray-50 border rounded-lg space-y-2.5">
          <div class="text-xs font-bold text-red-600 uppercase">S.L. 02</div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Package / Device Select</label>
            <select id="sl2DeviceSelect" onchange="onSl2DeviceChange()" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm bg-white">
              <option value="">Select Option</option>
              <option value="Basic device" data-price="1000">Basic device</option>
              <option value="Plus Device" data-price="1288">Plus Device</option>
              <option value="Pro Device" data-price="1500">Pro Device</option>
            </select>
          </div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Unit Price (Auto)</label>
            <input type="number" id="invUnit2" readonly required placeholder="0" class="w-full px-3 py-2 border rounded-lg bg-gray-100 text-gray-800 font-bold text-sm outline-none">
          </div>
        </div>

        <!-- S.L. 03 -->
        <div class="p-3 bg-gray-50 border rounded-lg space-y-2.5">
          <div class="text-xs font-bold text-red-600 uppercase">S.L. 03</div>
          <div>
            <label class="block text-gray-700 text-xs font-semibold mb-1">Description</label>
            <input type="text" id="invDesc3" required placeholder="Enter Description (e.g. 8801898519298)" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none text-sm bg-white">
          </div>
        </div>

        <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-lg shadow transition">
          Next <i class="fa-solid fa-arrow-right ml-1"></i>
        </button>
      </form>
    </div>

  </div>

  <!-- FULL INVOICE PREVIEW & DOWNLOAD SECTION -->
  <div id="invoicePreviewPage" class="hidden-page max-w-4xl mx-auto p-3 pb-24">
    <div class="bg-white p-3 rounded-xl shadow border mb-3 flex items-center justify-between">
      <button onclick="navigateTo('createInvoiceFormPage')" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold text-xs px-3 py-2 rounded-lg transition">
        <i class="fa-solid fa-arrow-left mr-1"></i> Edit Form
      </button>
      <span class="text-xs font-bold text-gray-700">Invoice Preview</span>
      <button onclick="navigateTo('homePage')" class="text-xs text-red-600 font-semibold">Home</button>
    </div>

    <div id="previewScrollContainer" class="overflow-x-auto bg-gray-200 p-2 rounded-xl">
      <div id="invoiceCaptureArea" class="invoice-sheet">
        <!-- Top Row -->
        <div class="inv-top-bar">
          <div class="inv-logo-mark">
            <svg width="66" height="66" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
              <polygon points="50,8 86,29 50,50 14,29" fill="#f97316"></polygon>
              <polygon points="14,29 50,50 50,92 14,71" fill="#ec4899"></polygon>
              <polygon points="86,29 86,71 50,92 50,50" fill="#e11d48"></polygon>
            </svg>
          </div>

          <div id="invoiceCompletedBadge" class="inv-completed-badge">COMPLETED</div>

          <div class="inv-header-right">
            <div class="inv-title">INVOICE</div>
            <div class="inv-brand">ROBI WIFI</div>
            <div class="inv-phone">+8801899999999</div>
          </div>
        </div>

        <!-- Billed To -->
        <div class="inv-billed-title">Billed To</div>

        <div class="inv-meta-grid">
          <div class="inv-meta-left">
            <div class="inv-meta-row">
              <span class="inv-label">Customer Name :</span>
              <span id="outCustName" class="inv-line-val"></span>
            </div>
            <div class="inv-meta-row">
              <span class="inv-label">Customer E-mail :</span>
              <span id="outCustEmail" class="inv-line-val"></span>
            </div>
          </div>

          <div class="inv-meta-right">
            <div class="inv-meta-row">
              <span class="inv-label">Invoice Number :</span>
              <span id="outInvNumber" class="inv-box-val"></span>
            </div>
            <div class="inv-meta-row">
              <span class="inv-label">Invoice Date :</span>
              <span id="outInvDate" class="inv-line-val" style="border-bottom:none; font-weight:800;"></span>
            </div>
          </div>
        </div>

        <div class="inv-payment-mode">
          Payment Mode : <span style="text-decoration: underline;">COD</span>
        </div>

        <!-- Items Table -->
        <table class="inv-table">
          <thead>
            <tr>
              <th style="width: 10%;">S. L.</th>
              <th style="width: 44%;">Description</th>
              <th style="width: 15%;">Unit</th>
              <th style="width: 12%;">Qty</th>
              <th style="width: 19%;">Amunt</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>01</td>
              <td id="outDesc1"></td>
              <td id="outUnit1"></td>
              <td>1</td>
              <td id="outAmt1"></td>
            </tr>
            <tr>
              <td>02</td>
              <td id="outDesc2"></td>
              <td id="outUnit2"></td>
              <td>1</td>
              <td id="outAmt2"></td>
            </tr>
            <tr>
              <td>03</td>
              <td id="outDesc3"></td>
              <td id="outUnit3">0</td>
              <td>1</td>
              <td id="outAmt3">0.00</td>
            </tr>
          </tbody>
        </table>

        <!-- Bottom Section: Real Scannable QR Code + Totals -->
        <div class="inv-bottom-grid">
          <div id="invoiceQrBox" class="inv-qr-box"></div>

          <div class="inv-totals-box">
            <div class="inv-total-line">
              <span>Subtotal :</span>
              <span id="outSubtotal">0.00</span>
            </div>
            <div class="inv-total-line">
              <span>Discount (%) :</span>
              <span>0.00</span>
            </div>
            <div class="inv-grand-total">
              <span>Total :   BDT</span>
              <span id="outTotal">0.00</span>
            </div>
          </div>
        </div>

        <div class="inv-footer-links">
          <a href="https://www.youtube.com/@robiwifibd" target="_blank" class="inv-yt-link">Youtube.com/@Robiwifibd</a>
        </div>

        <div class="inv-bottom-center">
          <a href="https://robiwifi.robi.com.bd" target="_blank" class="inv-web-link">https://robiwifi.robi.com.bd</a>
          <div class="inv-thank-btn">Thank You</div>
        </div>
      </div>
    </div>

    <!-- Single Crash-Safe Download Button -->
    <div class="mt-4">
      <button onclick="downloadInvoicePDF()" id="downloadPdfBtn" type="button" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-file-arrow-down text-lg"></i>
        <span>Download Invoice PDF</span>
      </button>
    </div>
  </div>

  <!-- Other Existing Pages Container -->
  <div class="max-w-md mx-auto p-4">

    <!-- BIND ISSUE FORM PAGE -->
    <div id="bindIssuePage" class="hidden-page bg-white p-5 rounded-xl shadow border">
      <div class="flex items-center mb-4 border-b pb-2">
        <button onclick="navigateTo('homePage')" class="text-gray-600 mr-3 text-lg"><i class="fa-solid fa-arrow-left"></i></button>
        <h3 class="font-bold text-lg text-gray-800">Bind Issue Submission</h3>
      </div>

      <form onsubmit="handleBindIssueSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Bind Issue</label>
          <select id="bindIssueSelect" onchange="toggleBindIssueFields()" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none bg-white">
            <option value="">Select Issue</option>
            <option value="Bind Issue">Bind Issue</option>
            <option value="Change Number">Change Number</option>
            <option value="Shwap">Shwap</option>
          </select>
        </div>

        <div id="shwapDeviceGroup" class="hidden-page">
          <label class="block text-gray-700 text-sm font-semibold mb-1">Device Select</label>
          <select id="shwapDeviceSelect" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none bg-white">
            <option value="">Select Device</option>
            <option value="5G Device">5G Device</option>
            <option value="Cat4 to Cat6 Device">Cat4 to Cat6 Device</option>
          </select>
        </div>

        <div id="oldLoginGroup" class="hidden-page">
          <label class="block text-gray-700 text-sm font-semibold mb-1">Old Login Number</label>
          <input type="text" id="oldLoginNumber" placeholder="Enter Old Login Number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Order Number</label>
          <input type="text" id="bindOrderNumber" required placeholder="Enter Order Number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">Login Number</label>
          <input type="text" id="bindLoginNumber" required placeholder="Enter Login Number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <div>
          <label class="block text-gray-700 text-sm font-semibold mb-1">FWA Number</label>
          <input type="text" id="bindFwaNumber" required placeholder="Enter FWA Number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <button type="submit" id="submitBindBtn" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-lg shadow transition">
          Submit
        </button>
      </form>
    </div>

    <!-- SEARCH PAGE -->
